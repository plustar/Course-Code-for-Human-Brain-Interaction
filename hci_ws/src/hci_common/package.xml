<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>hci_common</name>
  <version>1.0.0</version>
  <description>人机交互工程课程的地基包：相机模型、参数声明、节点运行、图像消息转换、测试辅助</description>
  <maintainer email="hci-course@example.com">HCI Course</maintainer>
  <license>AGPL-3.0-only</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>rcl_interfaces</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>

  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_mypy</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>ament_xmllint</test_depend>
  <test_depend>python3-hypothesis</test_depend>
  <test_depend>python3-pytest</test_depend>
  <test_depend>rmw_test_fixture_implementation</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
